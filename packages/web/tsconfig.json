{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@unvibed/viewer": [
        "../../../../unvibed-graph/viewer/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
